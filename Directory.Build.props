<Project>
  <PropertyGroup>
    <!-- Package version of every plugin in this repo (released together by one v<version> tag).
         0.8.1: first release from this repo (Fleans.Plugins.RestCaller 0.8.0 was published from fleans).
         0.9.0: the host joins clusters on Postgres membership/reminders and Kafka or Memory streams.
         Tracks the Fleans engine release the plugins are built against. -->
    <VersionPrefix>0.9.0</VersionPrefix>
    <!-- Fleans plugin-author packages (Fleans.Worker + abstractions) the plugins compile against.
         0.8.0 is the first release with the process instance business id on ExecuteCustomTaskEvent
         (nightBaker/fleans#824), returned to Camunda workers as businessKey. 0.9.0 is the first with
         Fleans.Streaming.Kafka on nuget.org (the host's Kafka streams) and Orleans 10.4. -->
    <FleansVersion>0.9.0</FleansVersion>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14</LangVersion>
    <Authors>nightBaker</Authors>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <RepositoryUrl>https://github.com/nightBaker/fleans-plugins</RepositoryUrl>
    <PackageProjectUrl>https://github.com/nightBaker/fleans-plugins</PackageProjectUrl>
  </PropertyGroup>
</Project>
