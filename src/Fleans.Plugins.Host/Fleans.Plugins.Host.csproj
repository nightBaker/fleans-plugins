<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The one ready-to-run worker: connects to the Fleans API over gRPC and runs every plugin in
       this repo. Each plugin is a NuGet package added here as a reference plus one line in
       Program.cs. Dependency closure: Fleans.ExternalTasks.Sdk (via the plugins) — no Orleans, no
       engine projects (CI guards it). -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <ContainerRepository>fleans-plugins</ContainerRepository>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fleans.Plugins.CamundaExternalTask\Fleans.Plugins.CamundaExternalTask.csproj" />
    <ProjectReference Include="..\Fleans.Plugins.RestCaller\Fleans.Plugins.RestCaller.csproj" />
  </ItemGroup>

</Project>
